{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x",
      "maxDuration": 60,
      "includeFiles": "furniture_db.json"
    },
    "api/furniture-db.js": {
      "runtime": "nodejs22.x",
      "includeFiles": "furniture_db.json"
    }
  },
  "routes": [
    {
      "src": "/furniture_db\\.json",
      "dest": "/api/furniture-db.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}


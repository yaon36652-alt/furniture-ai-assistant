{
  "version": 2,
  "routes": [
    {
      "src": "/furniture_db\\.json",
      "dest": "/api/furniture-db.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}

